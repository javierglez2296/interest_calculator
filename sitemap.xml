today = date.today().isoformat()
urls = set()

exclude_paths = [
    "/premium-ok",
    "/404",
]

money_paths = [
    "/calculadora",
    "/fire",
    "/hipoteca",
    "/rentabilidad-alquiler",
    "/comparador",
]

seo_keywords = [
    "interes-compuesto",
    "vivir-con",
    "hipoteca",
    "alquilar",
    "rentabilidad",
    "invertir",
    "fondos-indexados",
    "sp-500",
    "nasdaq",
]

manual_seo_paths = []

# =====================================================
# HIPOTECAS SEO
# =====================================================

for importe in [
    100000,
    120000,
    150000,
    180000,
    200000,
    250000,
    300000,
    350000,
    400000,
    500000,
]:
    manual_seo_paths.append(
        f"/hipoteca-{importe}-euros"
    )

# =====================================================
# INVERTIR X EUROS AL MES
# =====================================================

for aportacion in [
    100,
