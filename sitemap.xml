@server.route("/sitemap.xml", methods=["GET"])
def sitemap():
    today = date.today().isoformat()
    urls = set()

    for page in dash.page_registry.values():
        path = page.get("path")

        if not path:
            continue

        if "not_found" in str(page.get("module", "")).lower():
            continue

        if "premium-ok" in path:
            continue

        loc = f"{SITE_URL.rstrip('/')}{path}"

        if path == "/":
            priority = "1.0"
        elif path in ["/calculadora", "/fire", "/hipoteca", "/rentabilidad-alquiler"]:
            priority = "0.9"
        elif any(x in path for x in ["invertir", "dinero", "hipoteca", "alquiler"]):
            priority = "0.8"
        else:
            priority = "0.6"

        urls.add(f"""
  <url>
    <loc>{loc}</loc>
    <lastmod>{today}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>{priority}</priority>
  </url>""")

    xml = f"""<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{''.join(urls)}
</urlset>"""

    return Response(xml, mimetype="application/xml")
