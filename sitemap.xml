```
# =====================================================
# PÁGINAS DASH
# =====================================================

for page in dash.page_registry.values():
    path = page.get("path")

    if not path:
        continue

    if any(excluded in path for excluded in exclude_paths):
        continue

    if "not_found" in str(
        page.get("module", "")
    ).lower():
        continue

    # Ignorar plantillas dinámicas
    if "<" in path or ">" in path:
        continue

    if path == "/":
        priority = "1.0"

    elif path in money_paths:
        priority = "0.9"

    elif any(
        keyword in path
        for keyword in seo_keywords
    ):
        priority = "0.8"

    else:
        priority = "0.6"

    add_url(path, priority)

# =====================================================
# URLS SEO DINÁMICAS
# =====================================================

for path in manual_seo_paths:
    add_url(path, "0.8")

xml = f"""<?xml version="1.0" encoding="UTF-8"?>
```

<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{''.join(sorted(urls))}
</urlset>"""

```
return Response(
    xml,
    mimetype="application/xml",
)
